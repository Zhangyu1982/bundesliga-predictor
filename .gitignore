# 运行缓存 / 会话
__pycache__/
*.py[cod]
.pytest_cache/
/tmp/
*.log

# 数据库（运行时生成，不入库）
*.db
*.db-journal

# 截图 / 本地预览
screenshots/
.preview/

# 欧冠赛程缓存（运行时拉取）
data/historical/cl_*.json

# 敏感配置（Streamlit Cloud 用 Secrets 注入，勿入库）
.streamlit/secrets.toml

# 本地伤病缓存（运行时持久化，含用户手动录入，勿入库）
data/injuries_backup.json

# P5 首发抓取缓存（运行时拉取，可随时重建）。注意：data/baseline_xi.json 必须入库，
# 否则公网 Streamlit Cloud 上拿不到常规主力库，首发反推会静默失效。
data/lineup_p5_cache.json
data/scoreboard_p5_cache.json

# P5.1 大名单缓存（运行时拉取，TTL 24h；丢失后会自动重拉，不影响结果正确性）
data/roster_cache.json
